# Copy this file to .env and replace the values with your local PostgreSQL settings.
# Keep real credentials in .env only; .gitignore excludes it from Git.
PGHOST=localhost
PGPORT=5432
PGDATABASE=weather_travel_db
PGUSER=postgres
PGPASSWORD=replace-with-your-local-password
PGSSLMODE=disable
PORT=3000

# Google OAuth web client settings (never commit real values)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Generate a random secret of at least 32 characters for express-session.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Set true only when the app is behind one trusted reverse proxy.
TRUST_PROXY=false

# SMTP settings for reminder mail. For local development, Mailpit defaults are shown.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Weather Travel <no-reply@example.test>
